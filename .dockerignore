# Keep the build context small and the image free of anything that isn't
# the running service.

# Secrets -- never, under any circumstances, in an image layer
.env

# Local data: the container gets a fresh /data volume
*.db
*.db-wal
*.db-shm
agent_memory_store.json
*_memory_store.json
chroma_store/
evals-report.json

# CI's job, not the image's
tests/
evals/
.ruff_cache/
.pytest_cache/

# Local tooling and history
.venv/
.git/
.github/
.claude/
__pycache__/
*.py[cod]
.DS_Store

# README.md and LICENSE are NOT excluded: pyproject declares
# `readme = "README.md"` and `license = { file = "LICENSE" }`, so the build
# fails without them. They sit in the dependency layer, which a source edit
# doesn't invalidate anyway.
docker-compose.yml
fly.toml
