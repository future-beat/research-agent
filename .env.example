# Copy to .env and fill in your own keys. .env is gitignored, and is excluded
# from the Docker build context -- a key must never reach an image layer.
#
# Anthropic  -> https://console.anthropic.com/settings/keys
# Voyage AI  -> https://dashboard.voyageai.com/  (separate account from Anthropic)

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# --- optional: everything below has a working default -----------------------
# Full list and defaults are in the README's Configuration table.

# Per-run spend cap in USD. 0 disables it.
# AGENT_MAX_RUN_COST_USD=1.00

# json (default, for containers) or text (for a terminal).
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# json (default) | memory | chroma. chroma needs `pip install chromadb`.
# VECTOR_STORE=json

# Postgres for sessions, metrics, and pgvector notes. Setting this one
# variable moves all three off local disk and makes the service stateless.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Demo guardrails for a publicly reachable deployment.
# DEMO_DAILY_USD_CAP=5.00          # rolling 24h spend ceiling; 0 disables
# DEMO_RATE_LIMIT_PER_HOUR=10      # per visitor IP; 0 disables
# DEMO_TOKEN=                      # when set, writes need an X-Demo-Token header
